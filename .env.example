# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Sensor Configuration
CAMERA_INDEX=0
MICROPHONE_INDEX=0
SENSOR_UPDATE_INTERVAL=2.0  # seconds
USE_GPU=true  # For computer vision acceleration

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
ENABLE_MOCK_DATA=false  # Set to true for testing without hardware

# MCP Server
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3000

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=3001

# AI Configuration
ENERGY_THRESHOLD_HIGH=75
ENERGY_THRESHOLD_LOW=40
TRANSITION_SMOOTHNESS=high  # low, medium, high
MAX_DECISION_TIME=2.0  # seconds

# Music Configuration
MIN_BPM_DIFF=5  # Maximum BPM difference for transitions
PREVENT_REPEAT_WITHIN=7200  # seconds (2 hours)
DEFAULT_GENRE=electronic,dance,pop

# Privacy & Security
ENABLE_FACE_BLUR=false  # Blur faces in debug display
STORE_ANALYTICS=true  # Store anonymized analytics
MAX_STORED_DAYS=7

# Performance
VISION_FRAME_SKIP=2  # Process every Nth frame
AUDIO_BUFFER_SIZE=1024
MAX_CONCURRENT_REQUESTS=10
